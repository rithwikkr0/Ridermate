# Staging Environment Configuration
APP_NAME=RiderMate Staging
APP_ENV=staging
APP_VERSION=1.0.0-staging

# Firebase (Staging)
FIREBASE_API_KEY=staging_firebase_key
FIREBASE_PROJECT_ID=ridermate-staging

# Staging settings
LOG_LEVEL=info
ENABLE_DEBUG_MODE=false
ENABLE_HTTPS=true
MOCK_LOCATION_DATA=false

# Staging API
API_BASE_URL=https://staging-api.ridermate.com/api

# Monitoring
ENABLE_ERROR_TRACKING=true
ENABLE_PERFORMANCE_MONITORING=true
SENTRY_DSN=your_staging_sentry_dsn

# Feature flags (test new features)
ENABLE_SOCIAL_FEATURES=true
ENABLE_REFERRAL_SYSTEM=true
ENABLE_LOCATION_SHARING=true
